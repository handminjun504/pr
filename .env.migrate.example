# 이 파일을 복사해 .env.migrate 로 저장한 뒤 값을 채우세요. (.env.migrate 는 커밋하지 마세요)
#
# 선택 사항: 과거 Supabase에만 데이터가 있을 때 `npm run migrate:legacy-supabase-to-gl` 용.
# 신규·GL만 운영이면 이 파일과 이관 스크립트는 필요 없습니다.
#
# Supabase (레거시 이관 시만)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# PocketBase (gl 서버에서 실제 PB Admin API 주소 — MCP 4000 포트와 다를 수 있음)
POCKETBASE_URL=http://192.168.0.53:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
